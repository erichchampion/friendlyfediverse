# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm, set: export NODE_BINARY=/path/to/your/nvm/node in .xcode.env.local
#
# Use PATH when available; when building from Xcode GUI, PATH may be minimal,
# so we fall back to common node locations only if they exist.
NODE_BINARY=$(command -v node)
if [ -z "$NODE_BINARY" ]; then
  [ -x /opt/homebrew/bin/node ] && NODE_BINARY=/opt/homebrew/bin/node
  [ -z "$NODE_BINARY" ] && [ -x /usr/local/bin/node ] && NODE_BINARY=/usr/local/bin/node
  [ -z "$NODE_BINARY" ] && NODE_BINARY=$(command -v node)
fi
export NODE_BINARY
